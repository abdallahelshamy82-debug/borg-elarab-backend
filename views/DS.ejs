<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { pageTitle: 'Student Dashboard | Borg El Arab Tech' }) %>
    <style>
        .history-scroll {
            max-height: 430px;
            overflow-y: auto;
        }
        .kpi-row {
            margin-bottom: 4px;
        }
    </style>
</head>
<body>
    <%- include('partials/navbar', { showBalanceBadge: false }) %>

    <%
        const initials = (user && user.name ? user.name.trim().substring(0, 2) : 'ST').toUpperCase();
        const uniquePurchases = [];
        const seenItems = {};
        if (purchases && purchases.length > 0) {
            purchases.forEach(function (p) {
                if (p.Item && !seenItems[p.Item.id]) {
                    seenItems[p.Item.id] = true;
                    uniquePurchases.push(p.Item);
                }
            });
        }
    %>

    <main class="page-shell">
        <%- include('partials/toasts') %>

        <div class="dashboard-grid">
            <!-- Profile Sidebar -->
            <aside class="profile-sidebar">
                <div class="avatar" id="sidebarAvatar">
                    <% if (user.avatar_url) { %>
                        <img src="<%= user.avatar_url %>" alt="<%= user.name %>" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                        <span style="display: none;"><%= initials %></span>
                    <% } else { %>
                        <span><%= initials %></span>
                    <% } %>
                </div>

                <h1 class="student-name" id="sidebarName"><%= user.name %></h1>
                <p class="student-id" id="sidebarId"><%= user.email %></p>

                <div class="balance-box">
                    <h3>Available Core Points</h3>
                    <div class="points tabular-nums" id="dashboardBalance"><%= user.balance || 0 %> Pt</div>
                </div>

                <div class="sidebar-actions">
                    <a href="/recharge" class="btn btn-primary btn-block">Top-up Balance</a>
                    <a href="/store/ps" class="btn btn-outline btn-block">Browse Store</a>
                    <button type="button" class="btn btn-outline btn-block" onclick="document.getElementById('editProfileModal').classList.add('active')">Edit Profile</button>
                    <button type="button" class="btn btn-warning-outline btn-block" onclick="document.getElementById('changePasswordModal').classList.add('active')">Change Password</button>
                </div>
            </aside>

            <!-- Main Content -->
            <div class="main-content">
                <!-- Quick KPIs -->
                <section class="kpi-grid kpi-row">
                    <div class="kpi-card">
                        <div class="kpi-label">Wallet Balance</div>
                        <div class="kpi-value accent tabular-nums"><%= user.balance || 0 %> Pt</div>
                    </div>
                    <div class="kpi-card">
                        <div class="kpi-label">Owned Materials</div>
                        <div class="kpi-value tabular-nums"><%= uniquePurchases.length %></div>
                    </div>
                    <div class="kpi-card">
                        <div class="kpi-label">Total Recharged</div>
                        <div class="kpi-value tabular-nums"><%= typeof totalRecharged !== 'undefined' ? totalRecharged : 0 %> Pt</div>
                    </div>
                </section>

                <!-- Owned Library -->
                <section class="card-panel">
                    <div class="section-header">
                        <h2>My Digital Library</h2>
                        <a href="/store/ps" class="btn btn-accent-outline btn-sm">+ Get More</a>
                    </div>

                    <% if (uniquePurchases.length > 0) { %>
                        <div class="cards-grid" id="dashboardLibrary">
                            <% uniquePurchases.forEach(function (item) { %>
                                <article class="item-card">
                                    <div class="item-thumb">
                                        <img src="<%= item.image_url || '/images/course-placeholder.svg' %>" alt="<%= item.name %>" onerror="this.onerror=null; this.src='/images/course-placeholder.svg';">
                                        <span class="item-category-chip"><%= item.category %></span>
                                    </div>
                                    <div class="item-body">
                                        <h3 class="item-title"><%= item.name %></h3>
                                        <p class="item-desc"><%= item.description || 'University course material.' %></p>
                                        <div class="item-footer" style="border-top: none; padding-top: 6px;">
                                            <button
                                                type="button"
                                                class="btn btn-primary btn-block btn-sm open-viewer-btn"
                                                data-title="<%= item.name %>"
                                                data-category="<%= item.category %>"
                                                data-description="<%= item.description || 'No description provided.' %>"
                                                data-file="<%= item.file_path || '#' %>"
                                            >
                                                <%= (item.file_path && item.file_path !== '#') ? 'Open Material' : 'View Access Details' %>
                                            </button>
                                        </div>
                                    </div>
                                </article>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="empty-state">
                            <p style="margin-bottom: 14px;">You haven't unlocked any study materials yet.</p>
                            <a href="/store/ps" class="btn btn-primary btn-sm">Explore Resource Store</a>
                        </div>
                    <% } %>
                </section>

                <!-- Transaction History -->
                <section class="card-panel">
                    <div class="section-header">
                        <h2>Transaction History</h2>
                        <div class="filter-pills" id="txFilters">
                            <button type="button" class="pill-btn active" data-tx-filter="all">All</button>
                            <button type="button" class="pill-btn" data-tx-filter="purchase">Purchases</button>
                            <button type="button" class="pill-btn" data-tx-filter="recharge">Recharges</button>
                        </div>
                    </div>

                    <% if (transactions && transactions.length > 0) { %>
                    <div class="table-wrapper history-scroll">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Description</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody id="dashboardHistory">
                                <% transactions.forEach(function (tx) { %>
                                    <%
                                        const badgeClass = (tx.status === 'completed' || tx.status === 'success')
                                            ? 'badge-success'
                                            : (tx.status === 'pending' ? 'badge-warning' : 'badge-danger');
                                        const amountClass = tx.type === 'purchase'
                                            ? 'amount-sub'
                                            : (tx.isCredit ? 'amount-add' : (tx.status === 'pending' ? 'amount-pending' : 'amount-failed'));
                                        const amountPrefix = tx.type === 'purchase' ? '-' : (tx.isCredit ? '+' : '');
                                    %>
                                    <tr data-tx-type="<%= tx.type %>">
                                        <td class="tabular-nums" style="color: var(--text-secondary); white-space: nowrap;">
                                            <%= new Date(tx.date).toISOString().split('T')[0] %>
                                        </td>
                                        <td><%= tx.description %></td>
                                        <td class="tabular-nums <%= amountClass %>"><%= amountPrefix %><%= tx.amount %> Pt</td>
                                        <td><span class="badge <%= badgeClass %>"><%= tx.statusLabel %></span></td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                    <% } else { %>
                        <div class="empty-state">No transactions recorded yet.</div>
                    <% } %>
                </section>
            </div>
        </div>
    </main>

    <!-- Viewer Modal -->
    <div class="modal-overlay" id="viewerModal">
        <div class="modal-box" style="text-align: center;">
            <button type="button" class="close-modal" onclick="closeViewer()" aria-label="Close">&times;</button>
            <span class="badge badge-success" id="viewerCategory" style="margin-bottom: 12px;">Material</span>
            <h3 class="modal-title" id="viewerTitle" style="padding-right: 0;">Document Title</h3>
            <p class="modal-subtitle" id="viewerDesc" style="margin-bottom: 20px;">Preparing your resource...</p>
            <div id="viewerActionArea"></div>
        </div>
    </div>

    <!-- Edit Profile Modal -->
    <div class="modal-overlay" id="editProfileModal">
        <div class="modal-box">
            <button type="button" class="close-modal" onclick="closeEditProfile()" aria-label="Close">&times;</button>
            <h3 class="modal-title">Edit Profile</h3>
            <p class="modal-subtitle">Update your display name or profile picture.</p>

            <form action="/profile/update" method="POST" enctype="multipart/form-data">
                <div class="input-group">
                    <label for="editName">Display Name</label>
                    <input type="text" id="editName" name="name" value="<%= user.name %>" required minlength="2" placeholder="Enter your name">
                </div>

                <div class="input-group">
                    <label for="editAvatar">Upload Avatar Image (JPG/PNG/WebP)</label>
                    <input type="file" id="editAvatar" name="avatar" accept="image/png,image/jpeg,image/webp,image/gif">
                </div>

                <div class="input-group">
                    <label for="editAvatarUrl">Or Paste Persistent Avatar URL (Optional)</label>
                    <input type="url" id="editAvatarUrl" name="avatar_url" placeholder="https://...">
                </div>

                <% if (user.avatar_url) { %>
                <label style="display: flex; align-items: center; gap: 8px; font-size: 14px; color: var(--text-secondary); margin-bottom: 14px; cursor: pointer;">
                    <input type="checkbox" name="remove_avatar" value="1"> Remove current avatar photo
                </label>
                <% } %>

                <div class="modal-actions">
                    <button type="button" class="btn btn-outline" onclick="closeEditProfile()">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Change Password Modal -->
    <div class="modal-overlay" id="changePasswordModal">
        <div class="modal-box">
            <button type="button" class="close-modal" onclick="closeChangePassword()" aria-label="Close">&times;</button>
            <h3 class="modal-title">Change Local Password</h3>
            <p class="modal-subtitle">If you sign in solely through University Portal SSO, your main password is managed there.</p>

            <form action="/profile/password" method="POST">
                <div class="input-group">
                    <label for="current_password">Current Password</label>
                    <div class="input-wrap">
                        <input type="password" id="current_password" name="current_password" required placeholder="Enter current password" style="padding-right: 60px;">
                        <button type="button" class="toggle-password-btn" data-toggle-password="current_password">Show</button>
                    </div>
                </div>

                <div class="input-group">
                    <label for="new_password">New Password</label>
                    <div class="input-wrap">
                        <input type="password" id="new_password" name="new_password" required minlength="4" placeholder="Enter new password" style="padding-right: 60px;">
                        <button type="button" class="toggle-password-btn" data-toggle-password="new_password">Show</button>
                    </div>
                </div>

                <div class="input-group">
                    <label for="new_password_confirmation">Confirm New Password</label>
                    <input type="password" id="new_password_confirmation" name="new_password_confirmation" required minlength="4" placeholder="Confirm new password">
                </div>

                <div class="modal-actions">
                    <button type="button" class="btn btn-outline" onclick="closeChangePassword()">Cancel</button>
                    <button type="submit" class="btn btn-warning-outline">Update Password</button>
                </div>
            </form>
        </div>
    </div>

    <%- include('partials/scripts') %>
    <script>
        function closeEditProfile() {
            document.getElementById('editProfileModal').classList.remove('active');
        }
        function closeChangePassword() {
            document.getElementById('changePasswordModal').classList.remove('active');
        }
        function closeViewer() {
            document.getElementById('viewerModal').classList.remove('active');
        }

        document.querySelectorAll('.open-viewer-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var title = btn.dataset.title || 'Material';
                var category = btn.dataset.category || 'Resource';
                var desc = btn.dataset.description || '';
                var file = btn.dataset.file || '#';

                document.getElementById('viewerTitle').textContent = title;
                document.getElementById('viewerCategory').textContent = category;
                document.getElementById('viewerDesc').textContent = desc;

                var actionArea = document.getElementById('viewerActionArea');
                if (file && file !== '#') {
                    actionArea.innerHTML =
                        '<a href="' + encodeURI(file) + '" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-block">Launch / Download Resource</a>';
                } else {
                    actionArea.innerHTML =
                        '<div class="alert-banner warning" style="margin-bottom: 14px; text-align: left;"><span>Access Confirmed! This material is unlocked on your account and does not require a file download (or is delivered in person).</span></div>' +
                        '<button type="button" class="btn btn-outline btn-block" onclick="closeViewer()">Done</button>';
                }

                document.getElementById('viewerModal').classList.add('active');
            });
        });

        document.querySelectorAll('[data-tx-filter]').forEach(function (pill) {
            pill.addEventListener('click', function () {
                document.querySelectorAll('[data-tx-filter]').forEach(function (b) { b.classList.remove('active'); });
                pill.classList.add('active');
                var filter = pill.getAttribute('data-tx-filter');
                document.querySelectorAll('#dashboardHistory tr[data-tx-type]').forEach(function (row) {
                    var type = row.getAttribute('data-tx-type');
                    row.style.display = (filter === 'all' || type === filter) ? '' : 'none';
                });
            });
        });
    </script>
</body>
</html>
