<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { pageTitle: 'Resource Store | Borg El Arab Tech' }) %>
</head>
<body>
    <%- include('partials/navbar', { showBalanceBadge: true }) %>

    <%
        const currentBalance = user ? (user.balance || 0) : 0;
        const categories = [];
        if (items && items.length > 0) {
            items.forEach(function (it) {
                if (it.category && !categories.includes(it.category)) {
                    categories.push(it.category);
                }
            });
        }
    %>

    <main class="page-shell">
        <%- include('partials/toasts') %>

        <header class="page-header">
            <div>
                <h1 class="page-title">Resource <span style="color: var(--accent);">Store</span></h1>
                <p class="page-subtitle">Exchange your Core Points to unlock university notes, lectures, and exam packs.</p>
            </div>
            <a href="/recharge" class="btn btn-accent-outline btn-sm">+ Top-up Points</a>
        </header>

        <!-- Search & Category Filter Toolbar -->
        <div class="toolbar">
            <div class="filter-pills" id="categoryFilters">
                <button type="button" class="pill-btn active" data-category="all">All</button>
                <% categories.forEach(function (cat) { %>
                    <button type="button" class="pill-btn" data-category="<%= cat %>"><%= cat %></button>
                <% }); %>
            </div>

            <div class="search-input-box">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="text" id="storeSearchInput" placeholder="Search courses, notes, exams..." aria-label="Search store items">
            </div>
        </div>

        <!-- Store Cards Grid -->
        <div class="cards-grid" id="storeGrid">
            <% if (items && items.length > 0) { %>
                <% items.forEach(function (item) { %>
                    <%
                        const isPurchased = purchasedItemIds && purchasedItemIds.includes(item.id);
                        const canAfford = currentBalance >= item.price;
                    %>
                    <article
                        class="item-card store-item-card"
                        data-category="<%= item.category %>"
                        data-search="<%= ((item.name || '') + ' ' + (item.description || '') + ' ' + (item.category || '')).toLowerCase() %>"
                    >
                        <div class="item-thumb">
                            <img src="<%= item.image_url || '/images/course-placeholder.svg' %>" alt="<%= item.name %>" onerror="this.onerror=null; this.src='/images/course-placeholder.svg';">
                            <span class="item-category-chip"><%= item.category %></span>
                        </div>
                        <div class="item-body">
                            <h2 class="item-title"><%= item.name %></h2>
                            <p class="item-desc"><%= item.description || 'Official university digital resource.' %></p>

                            <div class="item-footer">
                                <div class="item-price tabular-nums"><%= item.price %> <span>Pt</span></div>
                                <% if (isPurchased) { %>
                                    <a href="/store/ds" class="btn btn-outline btn-sm">Owned &#10003;</a>
                                <% } else if (!canAfford) { %>
                                    <a href="/recharge" class="btn btn-warning-outline btn-sm">Need <%= item.price - currentBalance %> Pt</a>
                                <% } else { %>
                                    <button
                                        type="button"
                                        class="btn btn-accent-outline btn-sm unlock-item-btn"
                                        data-item-id="<%= item.id %>"
                                        data-item-name="<%= item.name %>"
                                        data-item-price="<%= item.price %>"
                                    >
                                        Unlock
                                    </button>
                                <% } %>
                            </div>
                        </div>
                    </article>
                <% }); %>
            <% } else { %>
                <div class="empty-state" style="grid-column: 1 / -1;">
                    No items available in the store yet.
                </div>
            <% } %>
        </div>

        <div class="empty-state" id="noFilterMatch" style="display: none; margin-top: 20px;">
            No materials matched your current filter or search.
        </div>
    </main>

    <!-- Purchase Confirmation Modal -->
    <div class="modal-overlay" id="purchaseModal">
        <div class="modal-box" style="text-align: center;">
            <button type="button" class="close-modal" onclick="closePurchaseModal()" aria-label="Close">&times;</button>
            <h3 class="modal-title" style="padding-right: 0;">Confirm Purchase</h3>
            <p class="modal-subtitle">Review your Core Points summary before unlocking.</p>

            <div class="card-panel" style="padding: 16px; background: var(--bg-base); text-align: left; margin-bottom: 10px;">
                <div style="font-size: 13px; color: var(--text-secondary); text-transform: uppercase;">Selected Resource</div>
                <div id="modalItemName" style="font-size: 19px; font-weight: 700; margin: 4px 0 12px;">Item</div>

                <div style="display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 6px;">
                    <span style="color: var(--text-secondary);">Item Price</span>
                    <strong class="tabular-nums" id="modalItemPrice" style="color: var(--accent);">0 Pt</strong>
                </div>
                <div style="display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 6px;">
                    <span style="color: var(--text-secondary);">Current Balance</span>
                    <strong class="tabular-nums"><%= currentBalance %> Pt</strong>
                </div>
                <div style="display: flex; justify-content: space-between; font-size: 15px; padding-top: 8px; border-top: 1px solid var(--border);">
                    <span>Balance After Purchase</span>
                    <strong class="tabular-nums" id="modalRemainingBalance" style="color: var(--accent);">0 Pt</strong>
                </div>
            </div>

            <form id="confirmPurchaseForm" method="POST" action="">
                <div class="modal-actions">
                    <button type="button" class="btn btn-outline" onclick="closePurchaseModal()">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="confirmPurchaseBtn" data-original-label="Confirm Unlock">
                        <span class="btn-label">Confirm Unlock</span>
                        <span class="spinner"></span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <%- include('partials/scripts') %>
    <script>
        var userBalance = Number(<%= currentBalance %>);
        var activeCategory = 'all';

        function closePurchaseModal() {
            document.getElementById('purchaseModal').classList.remove('active');
        }

        function applyStoreFilters() {
            var q = (document.getElementById('storeSearchInput').value || '').trim().toLowerCase();
            var cards = document.querySelectorAll('.store-item-card');
            var visible = 0;

            cards.forEach(function (card) {
                var cat = card.getAttribute('data-category');
                var text = card.getAttribute('data-search') || '';
                var catMatch = activeCategory === 'all' || cat === activeCategory;
                var qMatch = !q || text.indexOf(q) !== -1;

                if (catMatch && qMatch) {
                    card.style.display = '';
                    visible++;
                } else {
                    card.style.display = 'none';
                }
            });

            var emptyEl = document.getElementById('noFilterMatch');
            if (emptyEl) {
                emptyEl.style.display = (cards.length > 0 && visible === 0) ? 'block' : 'none';
            }
        }

        document.querySelectorAll('#categoryFilters .pill-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.querySelectorAll('#categoryFilters .pill-btn').forEach(function (b) { b.classList.remove('active'); });
                btn.classList.add('active');
                activeCategory = btn.getAttribute('data-category');
                applyStoreFilters();
            });
        });

        var searchInput = document.getElementById('storeSearchInput');
        if (searchInput) {
            searchInput.addEventListener('input', applyStoreFilters);
        }

        document.querySelectorAll('.unlock-item-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var id = btn.dataset.itemId;
                var name = btn.dataset.itemName;
                var price = Number(btn.dataset.itemPrice || 0);

                document.getElementById('modalItemName').textContent = name;
                document.getElementById('modalItemPrice').textContent = price + ' Pt';
                document.getElementById('modalRemainingBalance').textContent = Math.max(0, userBalance - price) + ' Pt';
                document.getElementById('confirmPurchaseForm').action = '/store/purchase/' + encodeURIComponent(id);
                document.getElementById('purchaseModal').classList.add('active');
            });
        });

        document.getElementById('confirmPurchaseForm').addEventListener('submit', function () {
            var btn = document.getElementById('confirmPurchaseBtn');
            btn.classList.add('loading');
            btn.querySelector('.btn-label').textContent = 'Processing...';
        });
    </script>
</body>
</html>
