<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= user.is_admin ? 'Admin' : 'Doctor' %> Dashboard | Core System</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Rajdhani', sans-serif;
        }

        html, body {
            overflow-x: hidden;
            width: 100%;
            max-width: 100vw;
        }

        body {
            background-color: #0f1016;
            color: white;
            min-height: 100vh;
            opacity: 0;
            animation: fadeIn 0.5s ease-in forwards;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }

        .navbar {
            background: rgba(21, 22, 30, 0.9);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid #2b2d3c;
            padding: 20px 50px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo {
            font-size: 24px;
            font-weight: 700;
            color: #fff;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .logo span {
            color: #ff0055; /* Admin accent color */
        }

        .nav-links {
            display: flex;
            gap: 30px;
        }

        .nav-links a, .nav-links button {
            color: #888;
            text-decoration: none;
            font-size: 18px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: color 0.3s;
            background: none;
            border: none;
            cursor: pointer;
        }

        .nav-links a:hover,
        .nav-links button:hover,
        .nav-links a.active {
            color: #ff0055;
        }

        /* --- Hamburger Menu --- */
        .hamburger {
            display: none;
            flex-direction: column;
            gap: 6px;
            cursor: pointer;
            z-index: 101;
            position: relative;
        }

        .hamburger span {
            width: 24px;
            height: 2px;
            background-color: #fff;
            border-radius: 2px;
            transition: all 0.3s ease;
        }

        .container {
            padding: 40px 50px;
            max-width: 1400px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 350px 1fr;
            gap: 40px;
        }

        .admin-sidebar {
            background: #15161e;
            border: 1px solid #2b2d3c;
            border-radius: 16px;
            padding: 30px;
            height: fit-content;
        }

        .admin-sidebar h2 {
            font-size: 24px;
            margin-bottom: 20px;
            border-bottom: 2px solid #2b2d3c;
            padding-bottom: 10px;
            color: #ff0055;
            text-transform: uppercase;
        }

        .input-group {
            margin-bottom: 20px;
            text-align: left;
        }

        .input-group label {
            display: block;
            color: #aaa;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 8px;
        }

        .input-group input {
            width: 100%;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid #3a3c4f;
            padding: 12px;
            border-radius: 8px;
            color: #fff;
            font-size: 16px;
            transition: all 0.3s;
            outline: none;
        }

        .input-group input:focus {
            border-color: #ff0055;
            background: rgba(255, 0, 85, 0.05);
            box-shadow: 0 0 15px rgba(255, 0, 85, 0.1);
        }

        .action-btn {
            display: block;
            width: 100%;
            background: rgba(255, 0, 85, 0.1);
            color: #ff0055;
            border: 1px solid #ff0055;
            padding: 12px;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            text-transform: uppercase;
        }

        .action-btn:hover {
            background: #ff0055;
            color: #fff;
        }

        .main-content {
            display: flex;
            flex-direction: column;
            gap: 40px;
        }

        .section-header {
            font-size: 24px;
            font-weight: 700;
            border-bottom: 2px solid #2b2d3c;
            padding-bottom: 15px;
            margin-bottom: 25px;
            color: #fff;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .history-table {
            width: 100%;
            border-collapse: collapse;
            background: #15161e;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid #2b2d3c;
        }

        .history-table th,
        .history-table td {
            padding: 15px 20px;
            text-align: left;
            border-bottom: 1px solid #2b2d3c;
        }

        .history-table th {
            background: #1a1c29;
            color: #888;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-size: 14px;
        }

        .history-table tr:hover {
            background: rgba(255, 255, 255, 0.02);
        }

        .status-active {
            color: #00ffaa;
            font-weight: 700;
        }

        .status-suspended {
            color: #ff4444;
            font-weight: 700;
        }

        .btn-small {
            background: transparent;
            color: #fff;
            border: 1px solid #3a3c4f;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 12px;
            cursor: pointer;
            transition: 0.3s;
        }

        .btn-small:hover {
            border-color: #ff0055;
            color: #ff0055;
        }

        /* --- Toast Notifications --- */
        #toast-container {
            position: fixed;
            bottom: 30px;
            right: 30px;
            display: flex;
            flex-direction: column;
            gap: 15px;
            z-index: 1000;
        }



        .toast {
            background: #15161e;
            color: #fff;
            border-left: 4px solid #00ffaa;
            padding: 15px 25px;
            border-radius: 8px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            font-size: 16px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: space-between;
            min-width: 300px;
            animation: slideIn 0.3s forwards;
        }

        .toast.error {
            border-left-color: #ff4444;
        }

        /* --- Tabs --- */
        .tabs {
            display: flex;
            gap: 15px;
            margin-bottom: 30px;
            border-bottom: 2px solid #2b2d3c;
            padding-bottom: 10px;
        }

        .tab-btn {
            background: none;
            border: none;
            color: #888;
            font-size: 18px;
            font-weight: 700;
            cursor: pointer;
            padding: 10px 20px;
            text-transform: uppercase;
            transition: color 0.3s;
            position: relative;
        }

        .tab-btn:hover, .tab-btn.active {
            color: #00ffaa;
        }

        .tab-btn.active::after {
            content: '';
            position: absolute;
            bottom: -12px;
            left: 0;
            width: 100%;
            height: 3px;
            background: #00ffaa;
            border-radius: 3px;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: grid;
            grid-template-columns: 350px 1fr;
            gap: 40px;
        }

        @media (max-width: 900px) {
            .navbar {
                padding: 15px 20px;
                backdrop-filter: none;
                -webkit-backdrop-filter: none;
                flex-wrap: wrap;
            }
            .logo {
                flex-grow: 1;
            }
            .hamburger {
                display: flex;
                order: 2;
                margin-left: auto;
                justify-content: center;
                align-items: center;
                margin-top: 5px;
            }
            .nav-links {
                position: fixed;
                top: 0;
                right: -250px;
                width: 250px;
                height: 100vh;
                background: #15161e;
                flex-direction: column;
                align-items: flex-start;
                padding: 80px 30px 30px;
                box-shadow: -10px 0 30px rgba(0, 0, 0, 0.5);
                transition: right 0.4s ease;
                z-index: 100;
                border-left: 1px solid #2b2d3c;
            }
            .nav-links.active {
                right: 0;
            }
            .hamburger.active span:nth-child(1) {
                transform: translateY(8px) rotate(45deg);
                background-color: #ff0055;
            }
            .hamburger.active span:nth-child(2) {
                opacity: 0;
            }
            .hamburger.active span:nth-child(3) {
                transform: translateY(-8px) rotate(-45deg);
                background-color: #ff0055;
            }

            .tab-content.active {
                grid-template-columns: 1fr;
            }
            .container {
                padding: 20px;
            }
            .stats-grid {
                grid-template-columns: 1fr;
            }
            .tabs {
                flex-wrap: wrap;
                justify-content: center;
                gap: 15px;
                margin-bottom: 30px;
            }
            .history-table {
                display: block;
                overflow-x: auto;
                white-space: nowrap;
            }
        }
    </style>
<style>

        /* Global Mobile Responsiveness Fallback */
        html, body {
            overflow-x: hidden !important;
            max-width: 100vw !important;
            width: 100% !important;
        }
        * {
            box-sizing: border-box !important;
        }
        img, video, canvas {
            max-width: 100%;
        }
        @media (max-width: 992px) {
            .container, .admin-container, .main-container, .login-box {
                width: 100% !important;
                padding-left: 15px !important;
                padding-right: 15px !important;
                grid-template-columns: 1fr !important;
            }
            .library-grid, .grid, .stats-grid {
                grid-template-columns: 1fr !important;
            }
            .profile-sidebar, .admin-sidebar {
                width: 100% !important;
                position: relative !important;
                right: 0 !important;
                height: auto !important;
            }
            .history-table {
                display: block !important;
                overflow-x: auto !important;
                white-space: nowrap !important;
                width: 100% !important;
            }
            .toast {
                min-width: 0 !important;
                width: 90vw !important;
                right: 5vw !important;
            }
            p, h1, h2, h3, h4, h5, h6, span, div, a, td, th {
                word-wrap: break-word !important;
                overflow-wrap: break-word !important;
            }
        }

</style>
</head>

<body>

    <nav class="navbar">
        <div class="logo"><%= user.is_admin ? 'System' : 'Course' %> <span>Management</span></div>
        <div class="hamburger" id="hamburgerMenu">
            <span></span>
            <span></span>
            <span></span>
        </div>
        <div class="nav-links" id="navLinks">
            <a href="/store/ds" class="active">View Profile</a>
            <form action="/logout" method="POST" style="display: inline;">
                <button type="submit">Logout</button>
            </form>
        </div>
    </nav>

    <div class="container" style="display: block;">
        
        <div class="tabs">
            <% if(user.is_admin) { %>
            <button class="tab-btn active" onclick="switchTab('users')">User Management</button>
            <% } %>
            <button class="tab-btn <%= !user.is_admin ? 'active' : '' %>" onclick="switchTab('courses')">Course Management</button>
        </div>

        <% if(success) { %>
            <div class="toast show" style="margin-bottom: 20px; position: relative; bottom: auto; right: auto; transform: none; min-width: auto; width: 100%;">
                <span><%= success %></span>
            </div>
        <% } %>
        <% if(error) { %>
            <div class="toast error show" style="margin-bottom: 20px; position: relative; bottom: auto; right: auto; transform: none; min-width: auto; width: 100%;">
                <span><%= error %></span>
            </div>
        <% } %>

        <% if(user.is_admin) { %>
        <!-- USERS TAB -->
        <div id="users-tab" class="tab-content active">
            <!-- Registration Form Sidebar -->
            <!-- Removed Add New User Sidebar -->

            <!-- Main Content -->
            <main class="main-content">
                <section>
                    <h2 class="section-header">Search User / Reset Password</h2>
                    <form action="/admin/users" method="GET" style="display: flex; gap: 15px; margin-bottom: 30px;">
                        <input type="text" name="query" required placeholder="Enter User ID (Email)..." style="flex: 1; background: rgba(255, 255, 255, 0.02); border: 1px solid #3a3c4f; padding: 12px; border-radius: 8px; color: #fff; font-size: 16px; outline: none;">
                        <button type="submit" class="action-btn" style="width: auto; padding: 0 30px;">Search User</button>
                    </form>
                </section>

                <!-- Removed System Users Table -->
            </main>
        </div>
        <% } %>

        <!-- COURSES TAB -->
        <div id="courses-tab" class="tab-content <%= !user.is_admin ? 'active' : '' %>">
            <!-- Course Upload Sidebar -->
            <aside class="admin-sidebar" style="height: fit-content; border-color: #00ffaa;">
                <h2 style="color: #00ffaa; border-color: #2b2d3c;">Upload Course Material</h2>
                <form action="/admin/courses" method="POST" enctype="multipart/form-data">
                    
                    <div class="input-group">
                        <label for="c_name">Title</label>
                        <input type="text" id="c_name" name="name" required placeholder="e.g. Physics 101 Notes">
                    </div>
                    <div class="input-group">
                        <label for="c_desc">Description</label>
                        <input type="text" id="c_desc" name="description" required placeholder="Brief description...">
                    </div>
                    <div class="input-group">
                        <label for="category">Category</label>
                        <select id="category" name="category" required style="width: 100%; background: rgba(255, 255, 255, 0.02); border: 1px solid #3a3c4f; padding: 12px; border-radius: 8px; color: #fff; font-size: 16px; outline: none;">
                            <option value="Notes" style="color: black;">Notes (PDF)</option>
                            <option value="Video Lectures" style="color: black;">Video Lectures (MP4)</option>
                            <option value="Exams" style="color: black;">Previous Exams</option>
                            <option value="Projects" style="color: black;">Project Files</option>
                        </select>
                    </div>
                    <div class="input-group">
                        <label for="price">Price (Pt)</label>
                        <input type="number" id="price" name="price" required min="0" placeholder="e.g. 150">
                    </div>

                    <div class="input-group">
                        <label for="cover_image">Cover Image Upload (required)</label>
                        <input type="file" id="cover_image" name="cover_image" accept="image/*" required style="padding: 10px;">
                    </div>
                    
                    <div class="input-group">
                        <label for="material_file">Course Material File</label>
                        <input type="file" id="material_file" name="material_file" style="padding: 10px;">
                        <small style="color:#888;">Leave empty if physical item</small>
                    </div>

                    <button type="submit" class="action-btn" style="color:#00ffaa; border-color:#00ffaa; background: rgba(0, 255, 170, 0.1);">Upload Material</button>
                </form>
            </aside>

            <!-- Main Content -->
            <main class="main-content">
                <section>
                    <h2 class="section-header">Uploaded Materials</h2>
                    <table class="history-table">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Type</th>
                                <th>Price</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (courses && courses.length > 0) { courses.forEach(course => { %>
                            <tr>
                                <td style="font-weight: 600;"><%= course.name %></td>
                                <td style="color: #888;"><%= course.category %></td>
                                <td style="color: #00ffaa; font-weight: bold;"><%= course.price %> Pt</td>
                                <td style="display: flex; gap: 10px; align-items: center;">
                                    <span style="color: #00ffaa; font-weight: 600;">Available</span>
                                    <form action="/admin/delete-item/<%= course.id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this material?');" style="margin: 0;">
                                        <button type="submit" style="background: rgba(255, 68, 68, 0.1); color: #ff4444; border: 1px solid #ff4444; border-radius: 6px; padding: 5px 10px; cursor: pointer; font-size: 12px; font-weight: bold;">Delete</button>
                                    </form>
                                </td>
                            </tr>
                            <% }) } else { %>
                            <tr>
                                <td colspan="4" style="text-align: center; color: #888;">No materials uploaded yet.</td>
                            </tr>
                            <% } %>
                        </tbody>
                    </table>
                </section>
            </main>
        </div>

    </div>

    <script>
        function switchTab(tabId) {
            // Hide all tab contents
            document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
            // Remove active class from buttons
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));

            // Show selected tab content
            document.getElementById(tabId + '-tab').classList.add('active');
            // Re-add active class to clicked button
            event.target.classList.add('active');
        }

        const hamburger = document.getElementById('hamburgerMenu');
        const navLinks = document.getElementById('navLinks');

        if (hamburger && navLinks) {
            hamburger.addEventListener('click', () => {
                hamburger.classList.toggle('active');
                navLinks.classList.toggle('active');
            });

            // Close menu when clicking outside
            document.addEventListener('click', (e) => {
                if (!hamburger.contains(e.target) && !navLinks.contains(e.target) && navLinks.classList.contains('active')) {
                    hamburger.classList.remove('active');
                    navLinks.classList.remove('active');
                }
            });
        }
    </script>

<!-- SECURITY SCRIPT -->
<style>
    body { user-select: none; -webkit-user-select: none; -moz-user-select: none; -ms-user-select: none; }
    input, textarea { user-select: text; -webkit-user-select: text; -moz-user-select: text; -ms-user-select: text; }
</style>
<script>
    document.addEventListener('contextmenu', event => event.preventDefault());
    document.addEventListener('keydown', function (event) {
        if (event.keyCode === 123) { // F12
            event.preventDefault();
        }
        if (event.ctrlKey && event.shiftKey && (event.keyCode === 73 || event.keyCode === 74)) { // Ctrl+Shift+I/J
            event.preventDefault();
        }
        if (event.ctrlKey && event.keyCode === 85) { // Ctrl+U
            event.preventDefault();
        }
    });
</script>
</body>

</html>
