<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head', { pageTitle: ((user.is_admin || user.role === 'admin') ? 'Admin' : 'Course') + ' Management | Borg El Arab Tech' }) %>
    <style>
        .search-bar-form {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }
        .search-bar-form input {
            flex: 1;
            min-width: 220px;
        }
        .course-mini-thumb {
            width: 44px;
            height: 36px;
            border-radius: 6px;
            object-fit: cover;
            border: 1px solid var(--border);
            flex-shrink: 0;
        }
        .course-title-cell {
            display: flex;
            align-items: center;
            gap: 12px;
        }
    </style>
</head>
<body class="theme-admin">
    <%- include('../partials/navbar', { showBalanceBadge: false }) %>

    <%
        const isFullAdmin = user && (user.is_admin || user.role === 'admin');
    %>

    <main class="page-shell">
        <%- include('../partials/toasts') %>

        <header class="page-header">
            <div>
                <h1 class="page-title"><%= isFullAdmin ? 'System' : 'Course' %> <span style="color: var(--accent);">Management</span></h1>
                <p class="page-subtitle">Monitor platform activity, manage course materials<%= isFullAdmin ? ', and look up student accounts' : '' %>.</p>
            </div>
            <% if (isFullAdmin) { %>
                <a href="/admin/users" class="btn btn-accent-outline btn-sm">User Lookup</a>
            <% } %>
        </header>

        <!-- KPI Summary Row -->
        <section class="kpi-grid" style="margin-bottom: 28px;">
            <div class="kpi-card">
                <div class="kpi-label">Registered Users</div>
                <div class="kpi-value tabular-nums"><%= stats ? stats.usersCount : 0 %></div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">Total Recharged</div>
                <div class="kpi-value accent tabular-nums"><%= stats ? stats.payments : 0 %> Pt</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">Store Sales</div>
                <div class="kpi-value tabular-nums"><%= stats ? stats.sales : 0 %> Pt</div>
            </div>
            <div class="kpi-card">
                <div class="kpi-label">Published Materials</div>
                <div class="kpi-value tabular-nums"><%= stats ? stats.itemsCount : (courses ? courses.length : 0) %></div>
            </div>
        </section>

        <!-- Tabs -->
        <div class="tabs">
            <% if (isFullAdmin) { %>
                <button type="button" class="tab-btn active" onclick="switchTab('users', this)">User Management</button>
            <% } %>
            <button type="button" class="tab-btn <%= !isFullAdmin ? 'active' : '' %>" onclick="switchTab('courses', this)">Course Management</button>
        </div>

        <% if (isFullAdmin) { %>
        <!-- USERS TAB -->
        <div id="users-tab" class="tab-content active">
            <section class="card-panel">
                <div class="section-header">
                    <h2>Find Student / Reset Password / Adjust Points</h2>
                </div>
                <form action="/admin/users" method="GET" class="search-bar-form">
                    <input type="text" name="query" class="input-control" required placeholder="Enter Student ID (e.g. 2420766), email, or name...">
                    <button type="submit" class="btn btn-primary">Search User</button>
                </form>
                <p style="color: var(--text-secondary); font-size: 13px; margin-top: 12px;">
                    Supports partial names, university IDs, <code>@batechu.com</code> emails, or system accounts.
                </p>
            </section>
        </div>
        <% } %>

        <!-- COURSES TAB -->
        <div id="courses-tab" class="tab-content <%= !isFullAdmin ? 'active' : '' %>">
            <div class="dashboard-grid">
                <!-- Publish Course Sidebar -->
                <aside class="profile-sidebar" style="text-align: left;">
                    <h2 style="font-size: 21px; margin-bottom: 16px; color: var(--accent); text-transform: uppercase;">Publish Material</h2>
                    <form action="/admin/courses" method="POST" enctype="multipart/form-data">
                        <div class="input-group">
                            <label for="c_name">Title</label>
                            <input type="text" id="c_name" name="name" required placeholder="e.g. Physics 101 Notes">
                        </div>

                        <div class="input-group">
                            <label for="c_desc">Description</label>
                            <textarea id="c_desc" name="description" rows="2" required placeholder="Brief summary of contents..."></textarea>
                        </div>

                        <div class="input-group">
                            <label for="category">Category</label>
                            <select id="category" name="category" required>
                                <option value="Notes">Notes (PDF)</option>
                                <option value="Video Lectures">Video Lectures (MP4)</option>
                                <option value="Exams">Previous Exams</option>
                                <option value="Projects">Project Files</option>
                            </select>
                        </div>

                        <div class="input-group">
                            <label for="price">Price (Pt)</label>
                            <input type="number" id="price" name="price" required min="0" placeholder="e.g. 150">
                        </div>

                        <div class="input-group">
                            <label for="cover_image">Upload Cover Image (Optional)</label>
                            <input type="file" id="cover_image" name="cover_image" accept="image/png,image/jpeg,image/webp,image/gif">
                        </div>

                        <div class="input-group">
                            <label for="image_url">Or Cover Image URL (Recommended for Cloud)</label>
                            <input type="url" id="image_url" name="image_url" placeholder="https://...">
                        </div>

                        <div class="input-group">
                            <label for="material_file">Upload Material File (Optional)</label>
                            <input type="file" id="material_file" name="material_file">
                        </div>

                        <div class="input-group">
                            <label for="file_path">Or External Resource Link (Drive / PDF / Video)</label>
                            <input type="text" id="file_path" name="file_path" placeholder="https://drive.google.com/...">
                        </div>

                        <button type="submit" class="btn btn-primary btn-block">Publish Material</button>
                    </form>
                </aside>

                <!-- Uploaded Materials Table -->
                <div class="main-content">
                    <section class="card-panel">
                        <div class="section-header">
                            <h2>Published Materials</h2>
                            <span class="badge badge-neutral"><%= courses ? courses.length : 0 %> items</span>
                        </div>

                        <% if (courses && courses.length > 0) { %>
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Material</th>
                                        <th>Category</th>
                                        <th>Price</th>
                                        <th>Resource</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% courses.forEach(function (course) { %>
                                        <tr>
                                            <td>
                                                <div class="course-title-cell">
                                                    <img src="<%= course.image_url || '/images/course-placeholder.svg' %>" alt="" class="course-mini-thumb" onerror="this.onerror=null; this.src='/images/course-placeholder.svg';">
                                                    <strong style="color: var(--text-primary);"><%= course.name %></strong>
                                                </div>
                                            </td>
                                            <td style="color: var(--text-secondary);"><%= course.category %></td>
                                            <td class="tabular-nums" style="color: #00ffaa; font-weight: 700;"><%= course.price %> Pt</td>
                                            <td>
                                                <% if (course.file_path && course.file_path !== '#') { %>
                                                    <a href="<%= course.file_path %>" target="_blank" rel="noopener noreferrer" class="badge badge-success" style="text-decoration: none;">Linked</a>
                                                <% } else { %>
                                                    <span class="badge badge-neutral">Physical / None</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <div class="table-actions">
                                                    <form action="/admin/delete-item/<%= course.id %>" method="POST" onsubmit="return confirm('Delete this material? Historical student purchase logs will be preserved.');">
                                                        <button type="submit" class="btn btn-danger-outline btn-sm">Delete</button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                        <% } else { %>
                            <div class="empty-state">No materials published yet.</div>
                        <% } %>
                    </section>
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/scripts') %>
    <script>
        function switchTab(tabId, btnEl) {
            document.querySelectorAll('.tab-content').forEach(function (tab) { tab.classList.remove('active'); });
            document.querySelectorAll('.tab-btn').forEach(function (btn) { btn.classList.remove('active'); });

            var target = document.getElementById(tabId + '-tab');
            if (target) target.classList.add('active');
            if (btnEl) btnEl.classList.add('active');
        }
    </script>
</body>
</html>
