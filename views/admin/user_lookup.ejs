<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head', { pageTitle: 'User Lookup | ' + (targetUser ? targetUser.name : 'Search User') }) %>
    <style>
        .search-bar-form {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }
        .search-bar-form input {
            flex: 1;
            min-width: 220px;
        }
        .info-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-bottom: 20px;
            text-align: left;
        }
        .info-item label {
            display: block;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: var(--text-secondary);
            margin-bottom: 4px;
        }
        .info-item .val {
            background: var(--bg-base);
            border: 1px solid var(--border);
            padding: 9px 12px;
            border-radius: var(--radius-sm);
            font-size: 15px;
            font-weight: 600;
            word-break: break-word;
        }
        .admin-section-title {
            font-size: 16px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            padding-top: 18px;
            margin-top: 18px;
            margin-bottom: 12px;
            border-top: 1px solid var(--border);
            text-align: left;
        }
        .results-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 14px;
            margin-top: 16px;
        }
        .result-user-card {
            background: var(--bg-base);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            padding: 16px;
            text-decoration: none;
            display: flex;
            flex-direction: column;
            gap: 6px;
            transition: border-color 0.2s, transform 0.2s;
        }
        .result-user-card:hover {
            border-color: var(--accent);
            transform: translateY(-2px);
        }
    </style>
</head>
<body class="theme-admin">
    <%- include('../partials/navbar', { showBalanceBadge: false }) %>

    <main class="page-shell">
        <%- include('../partials/toasts') %>

        <header class="page-header">
            <div>
                <h1 class="page-title">User <span style="color: var(--accent);">Lookup</span></h1>
                <p class="page-subtitle">Inspect student accounts, adjust wallet points, reset passwords, or toggle access.</p>
            </div>
            <a href="/admin/dashboard" class="btn btn-outline btn-sm">&larr; Back to Dashboard</a>
        </header>

        <!-- Search Form -->
        <section class="card-panel" style="margin-bottom: 24px;">
            <form action="/admin/users" method="GET" class="search-bar-form">
                <input type="text" name="query" class="input-control" value="<%= query || '' %>" required placeholder="Search by Student ID, Email, or Name...">
                <button type="submit" class="btn btn-primary">Search</button>
            </form>
        </section>

        <% if (searchResults && searchResults.length > 1) { %>
            <section class="card-panel" style="margin-bottom: 24px;">
                <div class="section-header">
                    <h2>Multiple Users Matched "<%= query %>"</h2>
                    <span class="badge badge-neutral"><%= searchResults.length %> found</span>
                </div>
                <div class="results-grid">
                    <% searchResults.forEach(function (u) { %>
                        <a href="/admin/users?query=<%= encodeURIComponent(u.email) %>" class="result-user-card">
                            <strong style="font-size: 17px; color: var(--text-primary);"><%= u.name %></strong>
                            <span style="font-size: 13px; color: var(--text-secondary); word-break: break-all;"><%= u.email %></span>
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 6px;">
                                <span class="badge <%= u.is_active ? 'badge-success' : 'badge-danger' %>"><%= u.is_active ? 'Active' : 'Suspended' %></span>
                                <strong class="tabular-nums" style="color: #00ffaa;"><%= u.balance %> Pt</strong>
                            </div>
                        </a>
                    <% }); %>
                </div>
            </section>
        <% } %>

        <% if (!targetUser && (!searchResults || searchResults.length === 0)) { %>
            <div class="empty-state">
                <% if (query) { %>
                    No user matched "<strong><%= query %></strong>". Try searching by Student ID (e.g. <code>2420766</code>), email, or partial name.
                <% } else { %>
                    Enter a Student ID, email, or name above to view user details.
                <% } %>
            </div>
        <% } else if (targetUser) { %>
            <div class="dashboard-grid">
                <!-- Sidebar: Target User Info & Admin Actions -->
                <aside class="profile-sidebar">
                    <h2 style="font-size: 20px; color: var(--accent); text-transform: uppercase; margin-bottom: 16px; text-align: left;">Account Details</h2>

                    <div class="info-list">
                        <div class="info-item">
                            <label>Full Name</label>
                            <div class="val"><%= targetUser.name %></div>
                        </div>
                        <div class="info-item">
                            <label>ID / Email</label>
                            <div class="val"><%= targetUser.email %></div>
                        </div>
                        <div class="info-item">
                            <label>Role</label>
                            <div class="val" style="text-transform: capitalize;"><%= targetUser.role %></div>
                        </div>
                        <div class="info-item">
                            <label>Wallet Balance</label>
                            <div class="val tabular-nums" style="color: #00ffaa;"><%= targetUser.balance %> Pt</div>
                        </div>
                        <div class="info-item">
                            <label>Account Status</label>
                            <div class="val">
                                <span class="badge <%= targetUser.is_active ? 'badge-success' : 'badge-danger' %>">
                                    <%= targetUser.is_active ? 'Active' : 'Suspended' %>
                                </span>
                            </div>
                        </div>
                    </div>

                    <% if (user && user.id !== targetUser.id) { %>
                        <form action="/admin/users/<%= targetUser.id %>/toggle-status" method="POST" style="margin-bottom: 14px;">
                            <button type="submit" class="btn <%= targetUser.is_active ? 'btn-danger-outline' : 'btn-emerald-outline' %> btn-block btn-sm">
                                <%= targetUser.is_active ? 'Suspend Account' : 'Reactivate Account' %>
                            </button>
                        </form>
                    <% } %>

                    <!-- Update Balance -->
                    <h3 class="admin-section-title" style="color: #00ffaa;">Update Balance</h3>
                    <form action="/admin/users/<%= targetUser.id %>/points" method="POST" class="confirm-user-action" data-action-msg="Update wallet balance for this user?">
                        <div class="input-group" style="margin-bottom: 12px;">
                            <input type="number" name="points" required placeholder="Amount (e.g. 500, -100)">
                        </div>
                        <div style="display: flex; gap: 14px; margin-bottom: 14px; font-size: 13px; color: var(--text-secondary);">
                            <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
                                <input type="radio" name="action" value="add" checked> Add / Subtract
                            </label>
                            <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
                                <input type="radio" name="action" value="set"> Set Exact
                            </label>
                        </div>
                        <button type="submit" class="btn btn-emerald-outline btn-block btn-sm">Apply Points</button>
                    </form>

                    <!-- Reset Password -->
                    <h3 class="admin-section-title" style="color: var(--warning);">Reset Password</h3>
                    <form action="/admin/users/<%= targetUser.id %>/password" method="POST" class="confirm-user-action" data-action-msg="Force reset local password for <%= targetUser.name %>?">
                        <div class="input-group" style="margin-bottom: 12px;">
                            <input type="text" name="new_password" required minlength="4" placeholder="Enter new password (min 4 chars)">
                        </div>
                        <button type="submit" class="btn btn-warning-outline btn-block btn-sm">Force Reset Password</button>
                    </form>
                </aside>

                <!-- Main Content: Purchases & Recharges -->
                <div class="main-content">
                    <section class="card-panel">
                        <div class="section-header">
                            <h2>Purchased Materials</h2>
                            <span class="badge badge-neutral"><%= targetUser.purchases ? targetUser.purchases.length : 0 %></span>
                        </div>
                        <% if (targetUser.purchases && targetUser.purchases.length > 0) { %>
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Item Name</th>
                                        <th>Category</th>
                                        <th>Cost</th>
                                        <th>Purchase Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% targetUser.purchases.forEach(function (purchase) { %>
                                        <tr>
                                            <td style="font-weight: 700;"><%= purchase.Item ? purchase.Item.name : 'Archived Material' %></td>
                                            <td style="color: var(--text-secondary);"><%= purchase.Item ? purchase.Item.category : 'N/A' %></td>
                                            <td class="tabular-nums"><%= purchase.amount || (purchase.Item ? purchase.Item.price : 0) %> Pt</td>
                                            <td class="tabular-nums" style="color: var(--text-secondary);">
                                                <%= purchase.createdAt ? new Date(purchase.createdAt).toISOString().split('T')[0] : 'N/A' %>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                        <% } else { %>
                            <div class="empty-state">No purchases found for this user.</div>
                        <% } %>
                    </section>

                    <section class="card-panel">
                        <div class="section-header">
                            <h2>Recharge History</h2>
                            <span class="badge badge-neutral"><%= targetUser.recharges ? targetUser.recharges.length : 0 %></span>
                        </div>
                        <% if (targetUser.recharges && targetUser.recharges.length > 0) { %>
                        <div class="table-wrapper">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Amount</th>
                                        <th>Method</th>
                                        <th>Status</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% targetUser.recharges.forEach(function (recharge) { %>
                                        <%
                                            const st = (recharge.status || '').toLowerCase();
                                            const badgeCls = st === 'success' ? 'badge-success' : (st === 'pending' ? 'badge-warning' : 'badge-danger');
                                            const stLabel = st === 'success' ? 'Completed' : (st === 'pending' ? 'Pending' : 'Failed');
                                        %>
                                        <tr>
                                            <td class="tabular-nums <%= st === 'success' ? 'amount-add' : (st === 'pending' ? 'amount-pending' : 'amount-failed') %>">
                                                <%= st === 'success' ? '+' : '' %><%= recharge.amount %> Pt
                                            </td>
                                            <td style="text-transform: uppercase;"><%= recharge.method %></td>
                                            <td><span class="badge <%= badgeCls %>"><%= stLabel %></span></td>
                                            <td class="tabular-nums" style="color: var(--text-secondary);">
                                                <%= recharge.createdAt ? new Date(recharge.createdAt).toISOString().split('T')[0] : 'N/A' %>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                        <% } else { %>
                            <div class="empty-state">No recharge history found.</div>
                        <% } %>
                    </section>
                </div>
            </div>
        <% } %>
    </main>

    <%- include('../partials/scripts') %>
    <script>
        document.querySelectorAll('.confirm-user-action').forEach(function (form) {
            form.addEventListener('submit', function (e) {
                var msg = form.dataset.actionMsg || 'Are you sure?';
                if (!confirm(msg)) e.preventDefault();
            });
        });
    </script>
</body>
</html>
