<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Details | <%= user ? user.name : 'Search User' %></title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Rajdhani', sans-serif;
        }

        html, body {
            overflow-x: hidden;
            width: 100%;
            max-width: 100vw;
        }

        body {
            background-color: #0f1016;
            color: white;
            min-height: 100vh;
            opacity: 0;
            animation: fadeIn 0.5s ease-in forwards;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }

        .navbar {
            background: rgba(21, 22, 30, 0.9);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid #2b2d3c;
            padding: 20px 50px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo {
            font-size: 24px;
            font-weight: 700;
            color: #fff;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .logo span {
            color: #ff0055;
        }

        .nav-links {
            display: flex;
            gap: 30px;
        }

        .nav-links a {
            color: #888;
            text-decoration: none;
            font-size: 18px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: color 0.3s;
        }

        .nav-links a:hover, .nav-links a.active {
            color: #ff0055;
        }

        /* --- Hamburger Menu --- */
        .hamburger {
            display: none;
            flex-direction: column;
            gap: 6px;
            cursor: pointer;
            z-index: 101;
            position: relative;
        }

        .hamburger span {
            width: 24px;
            height: 2px;
            background-color: #fff;
            border-radius: 2px;
            transition: all 0.3s ease;
        }

        .container {
            padding: 40px 50px;
            max-width: 1400px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 350px 1fr;
            gap: 40px;
        }

        .admin-sidebar {
            background: #15161e;
            border: 1px solid #2b2d3c;
            border-radius: 16px;
            padding: 30px;
            height: fit-content;
        }

        .admin-sidebar h2 {
            font-size: 24px;
            margin-bottom: 20px;
            border-bottom: 2px solid #2b2d3c;
            padding-bottom: 10px;
            color: #ff0055;
            text-transform: uppercase;
        }

        .info-group {
            margin-bottom: 15px;
        }

        .info-group label {
            display: block;
            color: #aaa;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 5px;
        }
        
        .info-group .value {
            color: #fff;
            font-size: 18px;
            font-weight: 600;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid #3a3c4f;
            padding: 10px;
            border-radius: 8px;
            word-break: break-all;
        }

        .status-active { color: #00ffaa; }
        .status-suspended { color: #ff4444; }

        .input-group {
            margin-bottom: 20px;
        }

        .input-group input {
            width: 100%;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid #3a3c4f;
            padding: 12px;
            border-radius: 8px;
            color: #fff;
            font-size: 16px;
            outline: none;
            transition: all 0.3s;
        }

        .input-group input:focus {
            border-color: #ff0055;
        }

        .action-btn {
            display: block;
            width: 100%;
            background: rgba(255, 0, 85, 0.1);
            color: #ff0055;
            border: 1px solid #ff0055;
            padding: 12px;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            text-transform: uppercase;
            text-align: center;
            text-decoration: none;
        }

        .action-btn:hover {
            background: #ff0055;
            color: #fff;
        }

        .main-content {
            display: flex;
            flex-direction: column;
            gap: 40px;
        }

        .section-header {
            font-size: 24px;
            font-weight: 700;
            border-bottom: 2px solid #2b2d3c;
            padding-bottom: 15px;
            margin-bottom: 25px;
            color: #fff;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .history-table {
            width: 100%;
            border-collapse: collapse;
            background: #15161e;
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid #2b2d3c;
        }

        .history-table th,
        .history-table td {
            padding: 15px 20px;
            text-align: left;
            border-bottom: 1px solid #2b2d3c;
        }

        .history-table th {
            background: #1a1c29;
            color: #888;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 14px;
        }

        .history-table tr:hover {
            background: rgba(255, 255, 255, 0.02);
        }

        /* Toast Notifications */
        .toast {
            background: #15161e;
            color: #fff;
            border-left: 4px solid #00ffaa;
            padding: 15px 25px;
            border-radius: 8px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            font-size: 16px;
            margin-bottom: 20px;
        }
        .toast.error { border-left-color: #ff4444; }

        @media (max-width: 900px) {
            .navbar {
                padding: 15px 20px;
                backdrop-filter: none;
                -webkit-backdrop-filter: none;
                flex-wrap: wrap;
            }
            .logo {
                flex-grow: 1;
            }
            .hamburger {
                display: flex;
                order: 2;
                margin-left: auto;
                justify-content: center;
                align-items: center;
                margin-top: 5px;
            }
            .nav-links {
                position: fixed;
                top: 0;
                right: -250px;
                width: 250px;
                height: 100vh;
                background: #15161e;
                flex-direction: column;
                align-items: flex-start;
                padding: 80px 30px 30px;
                box-shadow: -10px 0 30px rgba(0, 0, 0, 0.5);
                transition: right 0.4s ease;
                z-index: 100;
                border-left: 1px solid #2b2d3c;
            }
            .nav-links.active {
                right: 0;
            }
            .hamburger.active span:nth-child(1) {
                transform: translateY(8px) rotate(45deg);
                background-color: #ff0055;
            }
            .hamburger.active span:nth-child(2) {
                opacity: 0;
            }
            .hamburger.active span:nth-child(3) {
                transform: translateY(-8px) rotate(-45deg);
                background-color: #ff0055;
            }

            .container {
                grid-template-columns: 1fr;
                padding: 20px;
                gap: 20px;
            }
            .stats-grid {
                grid-template-columns: 1fr;
            }
            .history-grid {
                grid-template-columns: 1fr;
            }
            .search-box {
                flex-direction: column;
                gap: 10px;
            }
            .search-box button {
                width: 100%;
                border-radius: 8px;
            }
            .search-box input {
                border-radius: 8px;
            }
            .history-table {
                display: block;
                overflow-x: auto;
                white-space: nowrap;
            }
        }
    </style>
<style>

        /* Global Mobile Responsiveness Fallback */
        html, body {
            overflow-x: hidden !important;
            max-width: 100vw !important;
            width: 100% !important;
        }
        * {
            box-sizing: border-box !important;
        }
        img, video, canvas {
            max-width: 100%;
        }
        @media (max-width: 992px) {
            .container, .admin-container, .main-container, .login-box {
                width: 100% !important;
                padding-left: 15px !important;
                padding-right: 15px !important;
                grid-template-columns: 1fr !important;
            }
            .library-grid, .grid, .stats-grid {
                grid-template-columns: 1fr !important;
            }
            .profile-sidebar, .admin-sidebar {
                width: 100% !important;
                position: relative !important;
                right: 0 !important;
                height: auto !important;
            }
            .history-table {
                display: block !important;
                overflow-x: auto !important;
                white-space: nowrap !important;
                width: 100% !important;
            }
            .toast {
                min-width: 0 !important;
                width: 90vw !important;
                right: 5vw !important;
            }
            p, h1, h2, h3, h4, h5, h6, span, div, a, td, th {
                word-wrap: break-word !important;
                overflow-wrap: break-word !important;
            }
        }

</style>
</head>

<body>

    <nav class="navbar">
        <div class="logo">User <span>Lookup</span></div>
        <div class="hamburger" id="hamburgerMenu">
            <span></span>
            <span></span>
            <span></span>
        </div>
        <div class="nav-links" id="navLinks">
            <a href="/admin/dashboard" class="active">Back to Dashboard</a>
        </div>
    </nav>

    <div class="container" style="display: block; max-width: 1400px; margin: 0 auto; padding-top: 20px;">
        <% if(success) { %>
            <div class="toast show"><%= success %></div>
        <% } %>
        <% if(error) { %>
            <div class="toast error show"><%= error %></div>
        <% } %>
    </div>

    <div class="container">
    <div class="container">
        <% if (!user) { %>
            <div style="grid-column: 1 / -1; text-align: center; color: #888; padding: 40px; border: 1px dashed #2b2d3c; border-radius: 16px;">
                <h2>Search for a user by email to view their details.</h2>
            </div>
        <% } else { %>
        <!-- Sidebar - User Info & Password Reset -->
        <aside class="admin-sidebar">
            <h2>User Details</h2>
            
            <div class="info-group">
                <label>Name</label>
                <div class="value"><%= user.name %></div>
            </div>
            
            <div class="info-group">
                <label>User ID / Email</label>
                <div class="value"><%= user.email %></div>
            </div>

            <div class="info-group">
                <label>Role</label>
                <div class="value" style="text-transform: capitalize;"><%= user.role %></div>
            </div>

            <div class="info-group">
                <label>Balance</label>
                <div class="value" style="color: #00ffaa;"><%= user.balance %> Pt</div>
            </div>

            <div class="info-group">
                <label>Status</label>
                <div class="value <%= user.is_active ? 'status-active' : 'status-suspended' %>">
                    <%= user.is_active ? 'Active' : 'Suspended' %>
                </div>
            </div>

            <!-- Password Reset Section -->
            <h2 style="margin-top: 40px; border-color: #ffaa00; color: #ffaa00;">Reset Password</h2>
            <form action="/admin/users/<%= user.id %>/password" method="POST">
                
                <div class="input-group">
                    <input type="text" name="new_password" required placeholder="Enter New Password..." style="border-color: #555;">
                </div>
                <button type="submit" class="action-btn" onclick="return confirm('Are you sure you want to reset the password for <%= user.name %>?');" style="color: #ffaa00; border-color: #ffaa00; background: rgba(255, 170, 0, 0.1);">Force Reset</button>
            </form>

            <!-- Update Balance Section -->
            <h2 style="margin-top: 40px; border-color: #00ffaa; color: #00ffaa;">Update Balance</h2>
            <form action="/admin/users/<%= user.id %>/points" method="POST">
                
                <div class="input-group">
                    <input type="number" name="points" required placeholder="Amount (e.g. 500, -200)..." style="border-color: #555;">
                </div>
                <div class="input-group" style="display: flex; gap: 10px;">
                    <label style="color: #aaa; font-size: 14px; text-transform: uppercase; display: flex; align-items: center; gap: 5px;">
                        <input type="radio" name="action" value="add" checked style="width: auto;"> Add/Subtract
                    </label>
                    <label style="color: #aaa; font-size: 14px; text-transform: uppercase; display: flex; align-items: center; gap: 5px;">
                        <input type="radio" name="action" value="set" style="width: auto;"> Set Exact
                    </label>
                </div>
                <button type="submit" class="action-btn" onclick="return confirm('Are you sure you want to update the balance?');" style="color: #00ffaa; border-color: #00ffaa; background: rgba(0, 255, 170, 0.1);">Update Points</button>
            </form>
        </aside>

        <!-- Main Content - Purchases & Recharges -->
        <main class="main-content">
            
            <section>
                <h2 class="section-header">Purchased Items</h2>
                <table class="history-table">
                    <thead>
                        <tr>
                            <th>Item Name</th>
                            <th>Category</th>
                            <th>Cost</th>
                            <th>Purchase Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(user.purchases && user.purchases.length > 0) { %>
                            <% user.purchases.forEach(purchase => { %>
                            <tr>
                                <td style="font-weight: bold;"><%= purchase.Item ? purchase.Item.name : 'Deleted Item' %></td>
                                <td style="color: #888;"><%= purchase.Item ? purchase.Item.category : 'N/A' %></td>
                                <td><%= purchase.Item ? purchase.Item.price : 0 %> Pt</td>
                                <td style="color: #888;"><%= purchase.createdAt ? new Date(purchase.createdAt).toLocaleString() : 'N/A' %></td>
                            </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" style="text-align: center; color: #888;">No purchases found for this user.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </section>

            <section>
                <h2 class="section-header">Recharge History</h2>
                <table class="history-table">
                    <thead>
                        <tr>
                            <th>Amount</th>
                            <th>Method</th>
                            <th>Status</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if(user.recharges && user.recharges.length > 0) { %>
                            <% user.recharges.forEach(recharge => { %>
                            <tr>
                                <td style="font-weight: bold; color: #00ffaa;">+<%= recharge.amount %> Pt</td>
                                <td style="text-transform: capitalize;"><%= recharge.method %></td>
                                <td>
                                    <% if(recharge.status == 'success') { %>
                                        <span style="color: #00ffaa;">Completed</span>
                                    <% } else if(recharge.status == 'pending') { %>
                                        <span style="color: #ffaa00;">Pending</span>
                                    <% } else { %>
                                        <span style="color: #ff4444;">Failed</span>
                                    <% } %>
                                </td>
                                <td style="color: #888;"><%= recharge.createdAt ? new Date(recharge.createdAt).toLocaleString() : 'N/A' %></td>
                            </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" style="text-align: center; color: #888;">No recharge history found.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </section>

        </main>
        <% } %>
    </div>

    <script>
        function deletePurchase(purchaseId) {
            if(confirm('Are you sure you want to delete this purchase?')) {
                // To be implemented
                alert('Delete functionality to be implemented');
            }
        }

        const hamburger = document.getElementById('hamburgerMenu');
        const navLinks = document.getElementById('navLinks');

        if (hamburger && navLinks) {
            hamburger.addEventListener('click', () => {
                hamburger.classList.toggle('active');
                navLinks.classList.toggle('active');
            });

            // Close menu when clicking outside
            document.addEventListener('click', (e) => {
                if (!hamburger.contains(e.target) && !navLinks.contains(e.target) && navLinks.classList.contains('active')) {
                    hamburger.classList.remove('active');
                    navLinks.classList.remove('active');
                }
            });
        }
    </script>

<!-- SECURITY SCRIPT -->
<style>
    body { user-select: none; -webkit-user-select: none; -moz-user-select: none; -ms-user-select: none; }
    input, textarea { user-select: text; -webkit-user-select: text; -moz-user-select: text; -ms-user-select: text; }
</style>
<script>
    document.addEventListener('contextmenu', event => event.preventDefault());
    document.addEventListener('keydown', function (event) {
        if (event.keyCode === 123) { // F12
            event.preventDefault();
        }
        if (event.ctrlKey && event.shiftKey && (event.keyCode === 73 || event.keyCode === 74)) { // Ctrl+Shift+I/J
            event.preventDefault();
        }
        if (event.ctrlKey && event.keyCode === 85) { // Ctrl+U
            event.preventDefault();
        }
    });
</script>
</body>

</html>
