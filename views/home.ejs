<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { pageTitle: 'Student Portal Hub | Borg El Arab Tech' }) %>
    <style>
        .portal-hero {
            background: linear-gradient(145deg, rgba(0, 255, 170, 0.08), rgba(0, 163, 255, 0.05));
            border: 1px solid var(--border-strong);
            border-radius: var(--radius-lg);
            padding: 36px 28px;
            margin-bottom: 28px;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }
        .portal-hero h1 {
            font-size: clamp(26px, 4vw, 38px);
            font-weight: 700;
            line-height: 1.2;
        }
        .portal-hero p {
            color: var(--text-secondary);
            margin-top: 8px;
            max-width: 600px;
        }
        .portal-balance-card {
            background: var(--bg-surface);
            border: 1px solid rgba(0, 255, 170, 0.4);
            border-radius: var(--radius-md);
            padding: 18px 24px;
            min-width: 210px;
            text-align: center;
        }
        .portal-balance-card .lbl {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-secondary);
        }
        .portal-balance-card .val {
            font-family: 'Rajdhani', sans-serif;
            font-size: 36px;
            font-weight: 700;
            color: var(--accent);
            margin: 4px 0;
        }
        .hub-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 20px;
        }
        .hub-card {
            background: var(--bg-surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            padding: 24px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            text-decoration: none;
            transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
        }
        .hub-card:hover {
            transform: translateY(-4px);
            border-color: var(--accent);
            box-shadow: 0 12px 28px rgba(0, 0, 0, 0.4);
        }
        .hub-icon {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            background: var(--accent-dim);
            border: 1px solid rgba(0, 255, 170, 0.3);
            color: var(--accent);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
        }
        .hub-card h2 {
            font-size: 22px;
            color: var(--text-primary);
        }
        .hub-card p {
            color: var(--text-secondary);
            font-size: 14px;
            flex: 1;
        }
        .hub-cta {
            color: var(--accent);
            font-weight: 700;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.8px;
        }
    </style>
</head>
<body>
    <%- include('partials/navbar', { showBalanceBadge: true }) %>

    <main class="page-shell">
        <%- include('partials/toasts') %>

        <section class="portal-hero">
            <div>
                <span class="badge badge-success" style="margin-bottom: 10px;">Digital Services Active</span>
                <h1>Welcome back, <%= user.name %></h1>
                <p>Access your unlocked course library, manage your Core Points wallet, recharge securely with Paymob, and explore new university resources.</p>
            </div>
            <div class="portal-balance-card">
                <div class="lbl">Available Balance</div>
                <div class="val tabular-nums"><%= user.balance || 0 %> Pt</div>
                <a href="/recharge" class="btn btn-primary btn-sm btn-block">Top-up Points</a>
            </div>
        </section>

        <section class="hub-grid">
            <a href="/store/ds" class="hub-card">
                <div class="hub-icon">&#128218;</div>
                <h2>My Dashboard &amp; Library</h2>
                <p>View your profile, download or open purchased study materials, and inspect your transaction history.</p>
                <span class="hub-cta">Open Dashboard &rarr;</span>
            </a>

            <a href="/store/ps" class="hub-card">
                <div class="hub-icon">&#128722;</div>
                <h2>Resource Store</h2>
                <p>Browse lecture notes, video courses, previous exams, and project files using your points balance.</p>
                <span class="hub-cta">Browse Store &rarr;</span>
            </a>

            <a href="/recharge" class="hub-card">
                <div class="hub-icon">&#9889;</div>
                <h2>Recharge Wallet</h2>
                <p>Top up Core Points instantly via Paymob checkout (2 Pt = 1 EGP) with verified security.</p>
                <span class="hub-cta">Recharge Now &rarr;</span>
            </a>

            <% if (user && (user.is_admin || user.role === 'doctor' || user.role === 'admin')) { %>
            <a href="/admin/dashboard" class="hub-card" style="border-color: rgba(255, 46, 110, 0.4);">
                <div class="hub-icon" style="background: rgba(255, 46, 110, 0.12); border-color: rgba(255, 46, 110, 0.4); color: #ff2e6e;">&#9881;</div>
                <h2>Management Panel</h2>
                <p>Publish new course materials, review store metrics, and manage university accounts.</p>
                <span class="hub-cta" style="color: #ff2e6e;">Open Management &rarr;</span>
            </a>
            <% } %>
        </section>
    </main>

    <%- include('partials/scripts') %>
</body>
</html>
