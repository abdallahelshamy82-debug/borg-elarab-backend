<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { pageTitle: 'Core System Login | Borg El Arab Tech' }) %>
    <style>
        .auth-shell {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px 16px;
        }
        .login-card {
            width: 100%;
            max-width: 440px;
            background: var(--bg-surface);
            border: 1px solid var(--border-strong);
            border-radius: var(--radius-lg);
            padding: 36px 28px 32px;
            box-shadow: var(--shadow-lg);
            position: relative;
            overflow: hidden;
        }
        .login-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--blue), var(--accent));
        }
        .brand-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 5px 12px;
            border-radius: 999px;
            background: var(--accent-dim);
            border: 1px solid rgba(0, 255, 170, 0.3);
            color: var(--accent);
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 14px;
        }
        .login-header {
            text-align: center;
            margin-bottom: 28px;
        }
        .login-header h1 {
            font-size: 30px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
        }
        .login-header h1 span {
            color: var(--accent);
        }
        .login-header p {
            color: var(--text-secondary);
            font-size: 14px;
            margin-top: 6px;
        }
        .login-footer-note {
            margin-top: 20px;
            padding-top: 16px;
            border-top: 1px solid var(--border);
            text-align: center;
            color: var(--text-secondary);
            font-size: 13px;
            line-height: 1.5;
        }
        @media (max-width: 480px) {
            .login-card {
                padding: 28px 20px 24px;
            }
            .login-header h1 {
                font-size: 26px;
            }
        }
    </style>
</head>
<body>
    <main class="auth-shell">
        <div class="login-card">
            <div class="login-header">
                <div class="brand-pill">Digital Store &amp; Wallet</div>
                <h1>Borg El Arab <span>Tech</span></h1>
                <p>Sign in with your university Student ID or email</p>
            </div>

            <%- include('partials/toasts') %>

            <form id="loginForm" method="POST" action="/login">
                <div class="input-group">
                    <label for="studentEmail">Student ID / Email</label>
                    <input type="text" id="studentEmail" name="email" placeholder="e.g. 2420766 or name@batechu.com" required autocomplete="username" autofocus>
                </div>

                <div class="input-group">
                    <label for="password">Password</label>
                    <div class="input-wrap">
                        <input type="password" id="password" name="password" placeholder="••••••••" required autocomplete="current-password" style="padding-right: 60px;">
                        <button type="button" class="toggle-password-btn" data-toggle-password="password">Show</button>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-block" id="loginSubmitBtn" data-original-label="Initialize Session">
                    <span class="btn-label">Initialize Session</span>
                    <span class="spinner"></span>
                </button>
            </form>

            <div class="login-footer-note">
                University portal students can also access their Digital Profile directly via Single Sign-On (SSO) without entering a password.
            </div>
        </div>
    </main>

    <%- include('partials/scripts') %>
    <script>
        document.getElementById('loginForm').addEventListener('submit', function () {
            var btn = document.getElementById('loginSubmitBtn');
            btn.classList.add('loading');
            btn.querySelector('.btn-label').textContent = 'Signing in...';
        });
    </script>
</body>
</html>
