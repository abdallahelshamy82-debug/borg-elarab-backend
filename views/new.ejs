<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head', { pageTitle: 'Core Energy Recharge | Borg El Arab Tech' }) %>
    <style>
        .recharge-shell {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: calc(100vh - 80px);
            padding: 24px 16px 48px;
        }
        .recharge-card {
            width: 100%;
            max-width: 540px;
            background: var(--bg-surface);
            border: 1px solid var(--border-strong);
            border-radius: var(--radius-lg);
            padding: 32px 28px;
            box-shadow: var(--shadow-lg);
            position: relative;
            overflow: hidden;
        }
        .recharge-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--accent), var(--blue));
        }
        .recharge-header {
            text-align: center;
            margin-bottom: 24px;
        }
        .recharge-header h1 {
            font-size: 32px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .recharge-header p {
            color: var(--text-secondary);
            font-size: 14px;
            margin-top: 4px;
        }
        .conversion-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
            margin-bottom: 22px;
        }
        .conv-box {
            background: var(--bg-base);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            padding: 18px 14px;
            text-align: center;
        }
        .conv-box.highlight {
            border-color: rgba(0, 255, 170, 0.45);
            background: rgba(0, 255, 170, 0.05);
        }
        .conv-lbl {
            display: block;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.9px;
            color: var(--text-secondary);
            margin-bottom: 6px;
        }
        .conv-val {
            font-family: 'Rajdhani', sans-serif;
            font-size: 34px;
            font-weight: 700;
            line-height: 1;
        }
        .conv-val span {
            font-size: 16px;
            color: var(--text-secondary);
            margin-left: 4px;
        }
        .presets-row {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 20px;
            justify-content: center;
        }
        .preset-btn {
            min-height: 36px;
            padding: 6px 12px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--border-strong);
            background: var(--bg-elevated);
            color: var(--text-primary);
            font-family: 'Rajdhani', sans-serif;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.18s;
        }
        .preset-btn:hover,
        .preset-btn.active {
            border-color: var(--accent);
            background: var(--accent-dim);
            color: var(--accent);
        }
        .slider-box {
            margin-bottom: 22px;
        }
        .slider-labels {
            display: flex;
            justify-content: space-between;
            color: var(--text-secondary);
            font-size: 13px;
            font-weight: 600;
            margin-top: 10px;
        }
        .paymob-note {
            margin-top: 14px;
            text-align: center;
            font-size: 12px;
            color: var(--text-muted);
        }
        @media (max-width: 480px) {
            .recharge-card { padding: 26px 18px; }
            .conversion-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>
    <%- include('partials/navbar', { showBalanceBadge: true }) %>

    <main class="recharge-shell">
        <div class="recharge-card">
            <%- include('partials/toasts') %>

            <% if (typeof paymobReady !== 'undefined' && !paymobReady) { %>
                <div class="alert-banner warning">
                    <span>Paymob environment keys are not configured on this server yet. Checkout cannot start until configured.</span>
                </div>
            <% } %>

            <div class="recharge-header">
                <span class="badge badge-success" style="margin-bottom: 10px;">Rate: 2 Pt = 1 EGP</span>
                <h1>Core Energy</h1>
                <p>Select or type the Core Points amount you want to add</p>
            </div>

            <form action="/payment/initiate" method="POST" id="rechargeForm">
                <div class="conversion-grid">
                    <div class="conv-box highlight">
                        <span class="conv-lbl">Points Added</span>
                        <div class="conv-val tabular-nums" style="color: var(--accent);">
                            <span id="pointsOutput" style="font-size: inherit; color: inherit; margin: 0;">100</span><span>Pt</span>
                        </div>
                    </div>
                    <div class="conv-box">
                        <span class="conv-lbl">Total Cost</span>
                        <div class="conv-val tabular-nums">
                            <span id="priceOutput" style="font-size: inherit; color: inherit; margin: 0;">50</span><span>EGP</span>
                        </div>
                    </div>
                </div>

                <div class="presets-row" id="presetButtons">
                    <button type="button" class="preset-btn" data-pts="40">40 Pt</button>
                    <button type="button" class="preset-btn active" data-pts="100">100 Pt</button>
                    <button type="button" class="preset-btn" data-pts="200">200 Pt</button>
                    <button type="button" class="preset-btn" data-pts="500">500 Pt</button>
                    <button type="button" class="preset-btn" data-pts="1000">1000 Pt</button>
                </div>

                <div class="slider-box">
                    <input type="range" class="range-slider" id="pointSlider" min="20" max="2000" step="20" value="100" aria-label="Points slider">
                    <div class="slider-labels">
                        <span>20 Pt (10 EGP)</span>
                        <span>2000 Pt (1000 EGP)</span>
                    </div>
                </div>

                <div class="input-group">
                    <label for="amountInput">Exact Points Amount (Min 20 Pt)</label>
                    <input type="number" name="amount" id="amountInput" min="20" max="20000" step="2" value="100" required>
                </div>

                <button type="submit" class="btn btn-primary btn-block" id="payButton" data-original-label="Pay Securely with Paymob">
                    <span class="btn-label">Pay Securely with Paymob</span>
                    <span class="spinner"></span>
                </button>
            </form>

            <p class="paymob-note">Secured by Paymob Accept Checkout &bull; Verified via HMAC-SHA512</p>
        </div>
    </main>

    <%- include('partials/scripts') %>
    <script>
        var slider = document.getElementById('pointSlider');
        var amountInput = document.getElementById('amountInput');
        var pointsOutput = document.getElementById('pointsOutput');
        var priceOutput = document.getElementById('priceOutput');
        var presetBtns = document.querySelectorAll('.preset-btn');

        function syncAmount(val) {
            var pts = Math.max(20, Math.min(20000, parseInt(val, 10) || 20));
            var egp = pts * 0.5;
            pointsOutput.textContent = pts;
            priceOutput.textContent = Number.isInteger(egp) ? egp : egp.toFixed(1);

            var clampedSlider = Math.min(2000, Math.max(20, pts));
            slider.value = clampedSlider;
            var pct = ((clampedSlider - 20) / (2000 - 20)) * 100;
            slider.style.setProperty('--pct', pct + '%');

            presetBtns.forEach(function (b) {
                b.classList.toggle('active', Number(b.dataset.pts) === pts);
            });
        }

        slider.addEventListener('input', function () {
            amountInput.value = slider.value;
            syncAmount(slider.value);
        });

        amountInput.addEventListener('input', function () {
            syncAmount(amountInput.value);
        });

        presetBtns.forEach(function (btn) {
            btn.addEventListener('click', function () {
                amountInput.value = btn.dataset.pts;
                syncAmount(btn.dataset.pts);
            });
        });

        document.getElementById('rechargeForm').addEventListener('submit', function () {
            var payBtn = document.getElementById('payButton');
            payBtn.classList.add('loading');
            payBtn.querySelector('.btn-label').textContent = 'Connecting to Paymob...';
        });

        syncAmount(100);
    </script>
</body>
</html>
